<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>apf_optuna</name>
  <version>0.1.0</version>
  <description>Optuna trial orchestration and telemetry evaluation for VTOL APF tuning.</description>
  <maintainer email="jim.gaganakis@gmail.com">dimitris-gkagkanakis</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>drone_interfaces</exec_depend>
  <exec_depend>drone_bringup</exec_depend>
  <exec_depend>drone_control</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
