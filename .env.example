# Match the user that owns this checkout and the media directories.
LOCAL_UID=1000
LOCAL_GID=1000

DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=8765
DASHBOARD_RATE_HZ=60.0
ROS_DOMAIN_ID=0

PHOTO_DIR=./docker-data/photos
RECORD_DIR=./docker-data/recordings

# Keep BUILD_JOBS low because PX4 and the ROS workspace use substantial RAM.
BUILD_JOBS=2

# Intel/AMD render group. Check with: getent group render
RENDER_GID=109
