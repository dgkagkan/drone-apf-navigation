    <!-- Stage 1: sparse LiDAR target, centered on the nominal route. -->
    <model name="stage_1_thin_pole">
      <static>true</static>
      <pose>100 0 15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 30</size></box></geometry>
          <material>
            <ambient>0.95 0.1 0.1 1</ambient>
            <diffuse>0.95 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="repeat_y_plus_100">
        <pose>0 100 0 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1 1 30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 30</size></box></geometry>
