+float BatterySimulator::estimatePowerW() const
+{
+	if (!_armed) {
+		return _param_bat_idle_w.get();
+	}
+
+	if (_landed) {
+		return _param_bat_ground_w.get();
+	}
+
+	if (_vehicle_status.in_transition_mode) {
+		return _param_bat_transition_w.get();
+	}
+
+	float horizontal_speed_m_s = 0.f;
+	float climb_speed_m_s = 0.f;
+	if (_have_local_velocity) {
+		horizontal_speed_m_s = hypotf(_vehicle_local_position.vx, _vehicle_local_position.vy);
+		climb_speed_m_s = math::max(-_vehicle_local_position.vz, 0.f);
+	}
+
+	float power_w = 0.f;
+	if (_vehicle_status.vehicle_type == vehicle_status_s::VEHICLE_TYPE_FIXED_WING) {
+		const float reference_speed_m_s = math::max(_param_bat_fw_reference_m_s.get(), 1.f);
+		const float speed_ratio = math::constrain(horizontal_speed_m_s / reference_speed_m_s, 0.5f, 2.f);
+		power_w = _param_bat_fw_w.get() * (0.7f + 0.3f * speed_ratio * speed_ratio * speed_ratio);
+
+	} else {
+		power_w = _param_bat_mc_w.get() +
+			_param_bat_mc_speed_k.get() * horizontal_speed_m_s * horizontal_speed_m_s;
+	}
+
+	return power_w + _param_bat_climb_w.get() * climb_speed_m_s;
+}
+
+float BatterySimulator::openCircuitCellVoltage(float state_of_charge)
+{
+	const float state = math::constrain(state_of_charge, 0.f, 1.f);
+	const float empty_v = _battery.empty_cell_voltage();
+	const float charged_v = _battery.full_cell_voltage();
+	if (state <= 0.1f) return math::interpolate(state, 0.f, 0.1f, empty_v, 3.65f);
+	if (state <= 0.2f) return math::interpolate(state, 0.1f, 0.2f, 3.65f, 3.72f);
+	if (state <= 0.5f) return math::interpolate(state, 0.2f, 0.5f, 3.72f, 3.80f);
+	if (state <= 0.8f) return math::interpolate(state, 0.5f, 0.8f, 3.80f, 3.95f);
+	return math::interpolate(state, 0.8f, 1.f, 3.95f, charged_v);
+}
